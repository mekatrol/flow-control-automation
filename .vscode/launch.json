{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "debug: backend",
      "type": "coreclr",
      "request": "launch",
      "program": "${workspaceFolder}/backend/Server/Server.Api/bin/Debug/net10.0/Server.Api.dll",
      "cwd": "${workspaceFolder}/backend/Server/Server.Api",
      "preLaunchTask": "build: backend-debug",
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "SERVER_ADDRESS": "http://localhost:5008"
      },
      "stopAtEntry": false
    },
    {
      "name": "debug: frontend",
      "type": "pwa-chrome",
      "request": "launch",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}/frontend/flow-control-ui/src",
      "preLaunchTask": "debug: frontend server"
    }
  ],
  "compounds": [
    {
      "name": "dev",
      "configurations": [
        "debug: backend",
        "debug: frontend"
      ],
      "stopAll": true
    }
  ]
}
