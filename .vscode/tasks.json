{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "clean: backend",
      "type": "process",
      "command": "dotnet",
      "args": [
        "clean",
        "${workspaceFolder}/backend/Server/Server.slnx"
      ],
      "problemMatcher": "$msCompile",
      "group": "build"
    },
    {
      "label": "check format: backend",
      "type": "process",
      "command": "dotnet",
      "args": [
        "format",
        "${workspaceFolder}/backend/Server/Server.slnx",
        "--verify-no-changes"
      ],
      "problemMatcher": "$msCompile",
      "group": "test"
    },
    {
      "label": "format: backend",
      "type": "process",
      "command": "dotnet",
      "args": [
        "format",
        "${workspaceFolder}/backend/Server/Server.slnx"
      ],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "build: backend",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}/backend/Server/Server.slnx"
      ],
      "dependsOrder": "sequence",
      "dependsOn": "check format: backend",
      "problemMatcher": "$msCompile",
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "dev: backend",
      "type": "process",
      "command": "dotnet",
      "args": [
        "run",
        "--no-build",
        "--project",
        "${workspaceFolder}/backend/Server/Server.Api/Server.Api.csproj",
        "--launch-profile",
        "http"
      ],
      "options": {
        "cwd": "${workspaceFolder}/backend/Server"
      },
      "dependsOn": "build: backend",
      "isBackground": true,
      "problemMatcher": {
        "owner": "dotnet",
        "pattern": {
          "regexp": "^(?!)$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^.*$",
          "endsPattern": "^.*Now listening on: http://localhost:5008.*$"
        }
      },
      "presentation": {
        "group": "development",
        "panel": "dedicated",
        "reveal": "always"
      }
    },
    {
      "label": "dev: frontend",
      "type": "shell",
      "command": "npm run dev",
      "options": {
        "cwd": "${workspaceFolder}/frontend/flow-control-ui"
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "vite",
        "pattern": {
          "regexp": "^(?!)$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^.*VITE.*$",
          "endsPattern": "^.*Local:.*http://localhost:5173/.*$"
        }
      },
      "presentation": {
        "group": "development",
        "panel": "dedicated",
        "reveal": "always"
      }
    },
    {
      "label": "debug: frontend server",
      "type": "shell",
      "command": "npm run dev:debug",
      "options": {
        "cwd": "${workspaceFolder}/frontend/flow-control-ui"
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "vite",
        "pattern": {
          "regexp": "^(?!)$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^.*VITE.*$",
          "endsPattern": "^.*Local:.*http://localhost:5173/.*$"
        }
      },
      "presentation": {
        "group": "development",
        "panel": "dedicated",
        "reveal": "silent"
      }
    },
    {
      "label": "dev",
      "dependsOrder": "parallel",
      "dependsOn": [
        "dev: backend",
        "dev: frontend"
      ],
      "problemMatcher": []
    }
  ]
}
