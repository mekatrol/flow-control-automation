{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Set board",
      "type": "shell",
      "command": "${workspaceFolder}/scripts/controller-task.sh",
      "args": ["${workspaceFolder}", "set-board", "${input:controllerBoard}"],
      "windows": {
        "command": "powershell.exe",
        "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}\\scripts\\controller-task.ps1", "${workspaceFolder}", "set-board", "${input:controllerBoard}"]
      },
      "problemMatcher": []
    },
    {
      "label": "Clean",
      "type": "shell",
      "command": "${workspaceFolder}/scripts/controller-task.sh",
      "args": ["${workspaceFolder}", "clean"],
      "windows": {
        "command": "powershell.exe",
        "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}\\scripts\\controller-task.ps1", "${workspaceFolder}", "clean"]
      },
      "problemMatcher": []
    },
    {
      "label": "Clean all generated files",
      "type": "shell",
      "command": "${workspaceFolder}/scripts/controller-task.sh",
      "args": ["${workspaceFolder}", "clean-all"],
      "windows": {
        "command": "powershell.exe",
        "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}\\scripts\\controller-task.ps1", "${workspaceFolder}", "clean-all"]
      },
      "problemMatcher": []
    },
    {
      "label": "Format",
      "type": "shell",
      "command": "${workspaceFolder}/scripts/controller-task.sh",
      "args": ["${workspaceFolder}", "format"],
      "windows": {
        "command": "powershell.exe",
        "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}\\scripts\\controller-task.ps1", "${workspaceFolder}", "format"]
      },
      "problemMatcher": []
    },
    {
      "label": "Test all",
      "type": "shell",
      "command": "${workspaceFolder}/scripts/controller-task.sh",
      "args": ["${workspaceFolder}", "test"],
      "windows": {
        "command": "powershell.exe",
        "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}\\scripts\\controller-task.ps1", "${workspaceFolder}", "test"]
      },
      "group": {"kind": "test", "isDefault": true},
      "problemMatcher": "$gcc"
    },
    {
      "label": "Build",
      "type": "shell",
      "command": "${workspaceFolder}/scripts/controller-task.sh",
      "args": ["${workspaceFolder}", "build"],
      "windows": {
        "command": "powershell.exe",
        "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}\\scripts\\controller-task.ps1", "${workspaceFolder}", "build"]
      },
      "group": {"kind": "build", "isDefault": true},
      "problemMatcher": "$gcc"
    },
    {
      "label": "Flash",
      "type": "shell",
      "command": "${workspaceFolder}/scripts/controller-task.sh",
      "args": ["${workspaceFolder}", "flash", "${input:controllerSerialPort}"],
      "windows": {
        "command": "powershell.exe",
        "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}\\scripts\\controller-task.ps1", "${workspaceFolder}", "flash", "${input:controllerSerialPort}"]
      },
      "dependsOn": "Build",
      "problemMatcher": []
    },
    {
      "label": "Monitor",
      "type": "shell",
      "command": "${workspaceFolder}/scripts/controller-task.sh",
      "args": ["${workspaceFolder}", "monitor", "${input:controllerSerialPort}"],
      "windows": {
        "command": "powershell.exe",
        "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}\\scripts\\controller-task.ps1", "${workspaceFolder}", "monitor", "${input:controllerSerialPort}"]
      },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Flash and Monitor",
      "dependsOrder": "sequence",
      "dependsOn": ["Flash", "Monitor"],
      "problemMatcher": []
    },
    {
      "label": "Clean, Build, and Flash",
      "dependsOrder": "sequence",
      "dependsOn": ["Clean", "Flash"],
      "problemMatcher": []
    },
    {
      "label": "Clean, Build, Flash, and Monitor",
      "dependsOrder": "sequence",
      "dependsOn": ["Clean", "Flash", "Monitor"],
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "controllerBoard",
      "type": "pickString",
      "description": "Controller board",
      "options": ["kincony-kc868-a16"],
      "default": "kincony-kc868-a16"
    },
    {
      "id": "controllerSerialPort",
      "type": "promptString",
      "description": "Controller serial port (for example COM5 on Windows or /dev/ttyACM0 on Linux)",
      "default": ""
    }
  ]
}
