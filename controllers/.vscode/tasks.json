{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Set board",
      "type": "shell",
      "command": "${workspaceFolder}/scripts/controller-task.sh",
      "args": ["${workspaceFolder}", "set-board", "${input:controllerBoard}"],
      "problemMatcher": []
    },
    {
      "label": "Clean",
      "type": "shell",
      "command": "${workspaceFolder}/scripts/controller-task.sh",
      "args": ["${workspaceFolder}", "clean"],
      "problemMatcher": []
    },
    {
      "label": "Build",
      "type": "shell",
      "command": "${workspaceFolder}/scripts/controller-task.sh",
      "args": ["${workspaceFolder}", "build"],
      "group": {"kind": "build", "isDefault": true},
      "problemMatcher": "$gcc"
    },
    {
      "label": "Flash",
      "type": "shell",
      "command": "${workspaceFolder}/scripts/controller-task.sh",
      "args": ["${workspaceFolder}", "flash", "${input:serialPort}"],
      "dependsOn": "Build",
      "problemMatcher": []
    },
    {
      "label": "Monitor",
      "type": "shell",
      "command": "${workspaceFolder}/scripts/controller-task.sh",
      "args": ["${workspaceFolder}", "monitor", "${input:serialPort}"],
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Flash and Monitor",
      "dependsOrder": "sequence",
      "dependsOn": ["Flash", "Monitor"],
      "problemMatcher": []
    },
    {
      "label": "Clean, Build, and Flash",
      "dependsOrder": "sequence",
      "dependsOn": ["Clean", "Flash"],
      "problemMatcher": []
    },
    {
      "label": "Clean, Build, Flash, and Monitor",
      "dependsOrder": "sequence",
      "dependsOn": ["Clean", "Flash", "Monitor"],
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "controllerBoard",
      "type": "pickString",
      "description": "Controller board",
      "options": ["kincony-kc868-a16"],
      "default": "kincony-kc868-a16"
    },
    {
      "id": "serialPort",
      "type": "promptString",
      "description": "Controller serial port",
      "default": "/dev/ttyACM0"
    }
  ]
}
